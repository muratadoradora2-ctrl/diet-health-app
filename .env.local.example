# このファイルをコピーして .env.local を作成し、値を埋めてください。
# .env.local はgitにコミットされません（.gitignoreで除外済み）。
#
#   cp .env.local.example .env.local

# Supabase — Project Settings > API で確認できます（Phase 2の手順で案内します）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側でのみ使用する秘密鍵。NEXT_PUBLIC_を付けないため、
# ブラウザには一切送信されない。Phase 2時点のアプリコードでは未使用。
# 将来、AIアドバイスの書き込み（daily_ai_advice / weekly_ai_reviews）など
# 限定された処理でのみ使用する予定（docs/phase2-security-notes.md参照）。
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis（Rate Limit用）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Claude API（Phase 4以降で使用）
ANTHROPIC_API_KEY=
